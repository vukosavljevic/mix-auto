{
  "rewrites": [
    {
      "source": "/cjenici/:file",
      "destination": "https://niioxfdnzlfqkhepilyy.supabase.co/storage/v1/object/public/car-images/cjenici/:file"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}

